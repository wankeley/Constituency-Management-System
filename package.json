{
    "name": "constituency-management-system",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:client": "next dev",
        "dev:server": "node server/src/app.js",
        "build": "npx prisma generate && next build",
        "start": "concurrently \"node server/src/app.js\" \"next start\"",
        "start:server": "node server/src/app.js",
        "start:client": "next start",
        "db:migrate": "npx prisma migrate dev",
        "db:seed": "node prisma/seed.js",
        "db:reset": "npx prisma migrate reset --force && npm run db:seed"
    },
    "dependencies": {
        "@prisma/client": "^5.10.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^0.344.0",
        "multer": "^1.4.5-lts.1",
        "next": "^14.2.35",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^2.12.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "autoprefixer": "^10.4.0",
        "concurrently": "^8.2.0",
        "eslint": "^8.56.0",
        "eslint-config-next": "^16.1.2",
        "postcss": "^8.4.0",
        "prisma": "^5.10.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.0"
    }
}
